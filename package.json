{
  "name": "opportunities-tracker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "postinstall": "node scripts/prisma-generate.js",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "import:legacy": "tsx scripts/import-legacy-jobs.ts",
    "db:push:prod": "prisma db push --schema prisma/schema.postgres.prisma",
    "db:seed:prod": "tsx scripts/seed-research-programs.ts && tsx scripts/seed-scholarships.ts && tsx scripts/import-github-internships.ts",
    "vercel-build": "prisma generate --schema prisma/schema.postgres.prisma && next build"
  },
  "dependencies": {
    "@google/generative-ai": "^0.17.1",
    "@hello-pangea/dnd": "^16.6.0",
    "@prisma/client": "^5.20.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "lucide-react": "^0.383.0",
    "next": "14.2.5",
    "pdf-parse": "^1.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.40",
    "prisma": "^5.20.0",
    "tailwindcss": "^3.4.7",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4"
  }
