# Copy this file to .env for LOCAL development (SQLite), then fill in values.
# For production (Vercel + Neon), set these in the Vercel dashboard instead —
# see DEPLOYMENT.md. Never commit real values.

# ---------------------------------------------------------------------------
# LOCAL — SQLite
# ---------------------------------------------------------------------------
DATABASE_URL="file:./dev.db"

# ---------------------------------------------------------------------------
# PRODUCTION — PostgreSQL (Neon). Same var name, different value. Only set
# this in Vercel's env settings (or when running db:push:prod / db:seed:prod).
# Example: postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Auth — signs login session cookies. REQUIRED in production (the app refuses
# to start in production without it). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------------
AUTH_SECRET=change-me-to-a-random-64-char-hex-string

# ---------------------------------------------------------------------------
# Note: the Gemini API key for the CV Matcher is entered in the browser at
# /cv-match and stored in localStorage — it is NOT an env var, since each
# user brings their own key.
# ---------------------------------------------------------------------------
