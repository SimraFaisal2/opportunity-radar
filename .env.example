# Copy this file to .env and fill in real values.

# Prisma / SQLite
DATABASE_URL="file:./dev.db"

# Note: the Gemini API key for the CV Matcher (Feature 3) is entered directly
# in the browser UI at /cv-match and stored in your browser's local storage —
# it is not an env var, since each user brings their own key.

# Secret used to sign login session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=change-me-to-a-random-64-char-hex-string
